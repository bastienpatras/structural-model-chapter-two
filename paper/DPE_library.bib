@article{dye_disclosure_1985,
	title = {Disclosure of {Nonproprietary} {Information}},
	volume = {23},
	issn = {0021-8456},
	url = {https://www.jstor.org/stable/2490910},
	doi = {10.2307/2490910},
	abstract = {Equilibrium disclosure policies are derived for a class of models in which a firm's manager may or may not be privately informed about some aspect of the firm's value. When the manager is informed, he discloses only if the information is favorable relative to the market's prior beliefs. When he is uninformed, he cannot disclose. This distinction---between choosing not to disclose and being unable to disclose---creates ambiguity in interpreting non-disclosure and prevents the classic unraveling argument from applying.},
	number = {1},
	journal = {Journal of Accounting Research},
	author = {Dye, Ronald A.},
	year = {1985},
	pages = {123--145},
}

@article{jung_kwon_1988,
	title = {Disclosure {When} the {Market} is {Unsure} of {Information} {Endowment} of {Managers}},
	volume = {26},
	issn = {0021-8456},
	url = {https://www.jstor.org/stable/2491118},
	doi = {10.2307/2491118},
	abstract = {We extend Dye (1985) by characterizing equilibria in voluntary disclosure games when the market is uncertain whether the manager possesses private information. Partial pooling equilibria exist in which some informed managers with unfavorable information choose not to disclose, sheltering behind the population of genuinely uninformed managers. The model predicts that the probability of voluntary disclosure is increasing in the prior probability that the manager is informed.},
	number = {1},
	journal = {Journal of Accounting Research},
	author = {Jung, Woojin and Kwon, Young K.},
	year = {1988},
	pages = {146--153},
}

@article{shin_burden_1994,
	title = {The {Burden} of {Proof} in a {Game} of {Persuasion}},
	volume = {64},
	issn = {0022-0531},
	url = {https://www.sciencedirect.com/science/article/pii/S0022053184710606},
	doi = {10.1006/jeth.1994.1060},
	abstract = {This paper analyses a game of persuasion in which a sender has evidence concerning a state of nature, and a receiver makes a decision on the basis of the sender's communication. The informativeness of silence depends critically on the prior probability that the sender possesses evidence. When that probability is low, silence is nearly uninformative; when it is high, silence is treated as bad news. The paper characterises the unique equilibrium and its comparative statics.},
	number = {1},
	journal = {Journal of Economic Theory},
	author = {Shin, Hyun Song},
	year = {1994},
	pages = {253--264},
}

@article{fishman_mandatory_2003,
	title = {Mandatory versus {Voluntary} {Disclosure} in {Markets} with {Informed} and {Uninformed} {Customers}},
	volume = {19},
	issn = {8756-6222},
	url = {https://www.jstor.org/stable/3555046},
	doi = {10.1093/jleo/19.1.45},
	abstract = {We study markets in which sellers have private information about product quality and buyers differ in their ability to process disclosed information. We show that mandatory disclosure can reduce welfare relative to voluntary disclosure when unsophisticated buyers react noisily to disclosed signals, effectively penalising disclosure. The model identifies conditions under which mandates are beneficial and harmful, and derives implications for the design of disclosure requirements.},
	number = {1},
	journal = {Journal of Law, Economics, \& Organization},
	author = {Fishman, Michael J. and Hagerty, Kathleen M.},
	year = {2003},
	pages = {45--63},
}

@article{dranove_jin_2010,
	title = {Quality {Disclosure} and {Certification}: {Theory} and {Practice}},
	volume = {48},
	issn = {0022-0515},
	url = {https://www.aeaweb.org/articles?id=10.1257/jel.48.4.935},
	doi = {10.1257/jel.48.4.935},
	abstract = {We survey theoretical and empirical research on quality disclosure and certification. We discuss voluntary and mandatory disclosure, the role of third-party certifiers, and the conditions under which disclosure achieves efficient sorting of product quality. The survey documents systematic failures of disclosure in practice, particularly when buyers are heterogeneous in their capacity to process information, and highlights open questions for future research.},
	number = {4},
	journal = {Journal of Economic Literature},
	author = {Dranove, David and Jin, Ginger Zhe},
	year = {2010},
	pages = {935--963},
}

@article{jin_leslie_2003,
	title = {The {Effect} of {Information} on {Product} {Quality}: {Evidence} from {Restaurant} {Hygiene} {Grade} {Cards}},
	volume = {118},
	issn = {0033-5533},
	url = {https://academic.oup.com/qje/article/118/2/409/1942406},
	doi = {10.1162/003355303321675428},
	abstract = {We study the impact of mandatory disclosure of hygiene quality by examining a program in Los Angeles County that introduced letter-grade cards for restaurants. We find that the hygiene grade card program raised the average hygiene quality of restaurants, caused consumers to patronize higher-hygiene restaurants, and reduced foodborne illness hospitalizations. The response was largest among consumers who are most susceptible to food-related illness.},
	number = {2},
	journal = {Quarterly Journal of Economics},
	author = {Jin, Ginger Zhe and Leslie, Phillip},
	year = {2003},
	pages = {409--451},
}

@article{benshahar_failure_2011,
	title = {The {Failure} of {Mandated} {Disclosure}},
	volume = {159},
	issn = {0041-9907},
	url = {https://scholarship.law.upenn.edu/penn_law_review/vol159/iss3/1/},
	abstract = {Mandated disclosure is the most common regulatory technique in modern law. It is used in consumer protection, financial regulation, food and drug law, and many other domains. This article argues, from theory and evidence, that mandated disclosure systematically fails: disclosures are too complex or numerous for recipients to process; they arrive too late or in the wrong format; they are ignored or misunderstood. The article surveys failures across major regulatory domains and proposes standards for when disclosure requirements can succeed.},
	number = {3},
	journal = {University of Pennsylvania Law Review},
	author = {Ben-Shahar, Omri and Schneider, Carl E.},
	year = {2011},
	pages = {647--749},
}

@article{levitt_syverson_2008,
	title = {Market {Distortions} when {Agents} are {Better} {Informed}: {The} {Value} of {Information} in {Real} {Estate} {Transactions}},
	volume = {90},
	issn = {0034-6535},
	url = {https://www.mitpressjournals.org/doi/abs/10.1162/rest.90.4.599},
	doi = {10.1162/rest.90.4.599},
	abstract = {Real estate agents have better information about local housing markets than their clients. We exploit variation in whether agents are selling their own homes versus their clients' homes to identify the impact of this information advantage. Agents' own homes are on the market longer and sell for more. We also find that agents steer clients toward properties with higher commissions. The results suggest that information asymmetry between agents and clients generates significant market distortions.},
	number = {4},
	journal = {Review of Economics and Statistics},
	author = {Levitt, Steven D. and Syverson, Chad},
	year = {2008},
	pages = {599--611},
}

@article{garmaise_moskowitz_2004,
	title = {Confronting {Information} {Asymmetries}: {Evidence} from {Real} {Estate} {Markets}},
	volume = {17},
	issn = {0893-9454},
	url = {https://academic.oup.com/rfs/article/17/2/405/1614950},
	doi = {10.1093/rfs/hhg037},
	abstract = {Information asymmetries between buyers and sellers in commercial real estate create a market structure where informed buyers pay lower prices. We show that properties traded between sophisticated parties carry higher prices than those involving unsophisticated buyers, and that variation in information asymmetry across property types and locations explains differences in transaction patterns and market thickness.},
	number = {2},
	journal = {Review of Financial Studies},
	author = {Garmaise, Mark J. and Moskowitz, Tobias J.},
	year = {2004},
	pages = {405--437},
}

@article{lizzeri_1999,
	title = {Information {Revelation} and {Certification} {Intermediaries}},
	volume = {30},
	issn = {0741-6261},
	url = {https://www.jstor.org/stable/2556067},
	doi = {10.2307/2556067},
	abstract = {We study the incentives of a monopolist certifier who grades the quality of producers. We show that the certifier maximises profits by withholding information strategically: a fully informative disclosure policy is not generally profit-maximising. The model generates predictions about the structure of certification markets and the welfare consequences of certifier monopoly versus competition.},
	number = {2},
	journal = {RAND Journal of Economics},
	author = {Lizzeri, Alessandro},
	year = {1999},
	pages = {214--231},
}

@article{brounen_kok_2011,
	title = {On the {Economics} of {Energy} {Labels} in the {Housing} {Market}},
	volume = {62},
	issn = {0095-0696},
	url = {https://www.sciencedirect.com/science/article/pii/S0095069611000691},
	doi = {10.1016/j.jeem.2011.05.006},
	abstract = {We study the impact of mandatory energy performance certificate disclosure on housing transaction prices in the Netherlands. Using a dataset of over 31,000 transactions, we find that A/B-rated homes sell at a 2--5\% premium over G-rated homes, with the premium larger in markets with higher energy prices and more energy-conscious buyers. The results provide evidence that energy labels are capitalized into housing prices and that the magnitude of the capitalization varies with local buyer characteristics.},
	number = {2},
	journal = {Journal of Environmental Economics and Management},
	author = {Brounen, Dirk and Kok, Nils},
	year = {2011},
	pages = {166--179},
}

@article{eichholtz_kok_quigley_2010,
	title = {Doing {Well} by {Doing} {Good}? {Green} {Office} {Buildings}},
	volume = {100},
	issn = {0002-8282},
	url = {https://www.aeaweb.org/articles?id=10.1257/aer.100.5.2492},
	doi = {10.1257/aer.100.5.2492},
	abstract = {We analyze the economics of green certification in commercial real estate. Using a sample of 694 certified office buildings and nearby controls, we find that green buildings command rental premiums of about 3\% and transaction price premiums of about 16\%. These premiums have grown over time and are larger in markets with more sophisticated tenants and owners. The results suggest that environmental certification is valued by the market and that this valuation is not merely a reflection of energy savings.},
	number = {5},
	journal = {American Economic Review},
	author = {Eichholtz, Piet and Kok, Nils and Quigley, John M.},
	year = {2010},
	pages = {2492--2509},
}

@article{hyland_lyons_2013,
	title = {The {Value} of {Domestic} {Building} {Energy} {Efficiency} -- {Evidence} from {Ireland}},
	volume = {40},
	issn = {0140-9883},
	url = {https://www.sciencedirect.com/science/article/pii/S0140988313001096},
	doi = {10.1016/j.eneco.2013.06.020},
	abstract = {We estimate the price premium associated with energy performance certificate (EPC) ratings for residential properties in Ireland. Using a large sample of transactions matched to official EPC data, we find that better-rated homes command premiums of up to 9\% relative to the lowest-rated properties. The premium is larger for primary residences and in areas with higher heating degree days, consistent with buyers pricing energy costs into their willingness to pay.},
	journal = {Energy Economics},
	author = {Hyland, Marie and Lyons, Ronan C. and Lyons, Seán},
	year = {2013},
	pages = {943--952},
}

@article{fuerst_energy_2016,
	title = {Energy {Performance} {Ratings} and {House} {Prices} in {Wales}: {An} {Empirical} {Study}},
	volume = {92},
	issn = {0301-4215},
	url = {https://www.sciencedirect.com/science/article/pii/S0301421516300970},
	doi = {10.1016/j.enpol.2016.01.024},
	abstract = {We estimate the effect of Energy Performance Certificate (EPC) ratings on house prices in Wales using a dataset of over 200,000 residential transactions. We find statistically significant price gradients across EPC bands, with A/B-rated properties selling at a premium of approximately 5--8\% relative to E-rated properties. The premium is larger among younger buyers and in areas with higher energy costs, consistent with variation in buyer sensitivity to energy performance.},
	journal = {Energy Policy},
	author = {Fuerst, Franz and McAllister, Pat and Nanda, Anupam and Wyatt, Peter},
	year = {2016},
	pages = {20--33},
}

@article{houde_consumers_2014,
	title = {How {Consumers} {Respond} to {Environmental} {Certification} and the {Value} of {Energy} {Information}},
	volume = {45},
	issn = {0741-6261},
	url = {https://www.jstor.org/stable/43895580},
	doi = {10.1111/1756-2171.12079},
	abstract = {I estimate how consumers respond to the Energy Star certification label for appliances and quantify the value of energy information. Using detailed transaction data, I find that the certification raises demand but that a large share of consumers is nearly unresponsive to the energy label. This heterogeneity in responsiveness means that the aggregate price premium for certification understates the value to energy-sensitive buyers and overstates it for the rest. The findings imply that the social value of energy information depends critically on the share of consumers who are attentive to energy costs.},
	number = {4},
	journal = {RAND Journal of Economics},
	author = {Houde, S{\'e}bastien},
	year = {2014},
	pages = {785--810},
}

@article{gillingham_palmer_2014,
	title = {Bridging the {Energy} {Efficiency} {Gap}: {Policy} {Insights} from {Economic} {Theory} and {Empirical} {Evidence}},
	volume = {8},
	issn = {1750-6816},
	url = {https://academic.oup.com/reep/article/8/1/18/1558137},
	doi = {10.1093/reep/ret021},
	abstract = {We review the theoretical and empirical literature on the energy efficiency gap, synthesizing insights on when and how policy intervention is warranted. We discuss the role of market failures---including information asymmetries, principal-agent problems, and credit constraints---and behavioural failures. We assess the effectiveness of various policy instruments including mandatory standards, subsidies, and information disclosure programs, and identify the conditions under which each is most effective.},
	number = {1},
	journal = {Review of Environmental Economics and Policy},
	author = {Gillingham, Kenneth and Palmer, Karen},
	year = {2014},
	pages = {18--38},
}

@article{nauleau_2014,
	title = {Free-{Riding} on {Tax} {Credits} for {Home} {Insulation} in {France}: {An} {Econometric} {Assessment} {Using} {Panel} {Data}},
	volume = {46},
	issn = {0140-9883},
	url = {https://www.sciencedirect.com/science/article/pii/S0140988314001571},
	doi = {10.1016/j.eneco.2014.08.007},
	abstract = {We estimate the extent of free-riding on the French tax credit for residential energy efficiency renovation (crédit d'impôt développement durable). Using panel data on French households, we find that a substantial fraction of subsidy beneficiaries would have undertaken the renovation without the credit. We document significant heterogeneity in free-riding rates across household types and renovation measures, with larger free-riding among higher-income households. The results imply that uniform national subsidies entail significant deadweight loss.},
	journal = {Energy Economics},
	author = {Nauleau, Marie-Laure},
	year = {2014},
	pages = {78--92},
}

