	doi = {10.1016/0165-4101(83)90011-3},
	abstract = {This paper derives conditions under which firms voluntarily disclose private information to the market. Firms withhold information only when the proprietary cost of disclosure exceeds the benefit from reduced adverse selection. The model produces a threshold equilibrium in which all firms with sufficiently favourable news disclose, and the disclosure threshold is endogenously determined by the market's prior beliefs and the distribution of proprietary costs.},
