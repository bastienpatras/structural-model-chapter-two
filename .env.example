# ---------------------------------------------------------------------------
# Database (shared by enrich_listings.py and collect_listings.py)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=4444
DB_USER=
DB_PASSWORD=
DB_NAME=listing_dev

# ---------------------------------------------------------------------------
# GCS (shared)
# ---------------------------------------------------------------------------
GCS_BUCKET=ma-data-dev

# ---------------------------------------------------------------------------
# enrich_listings.py
# ---------------------------------------------------------------------------
GCS_ADEME_DPE_PREFIX=ADEME/DPE/ADEME_GEOCODED_SUBREGION_CODE_
ADEME_MIN_MATCH_SCORE=0.3
# Set to 1 to upload intermediate match results back to GCS
ADEME_SAVE_TO_GCS=0
# GCS directory for intermediate match results (used when ADEME_SAVE_TO_GCS=1)
ADEME_GCS_DIRECTORY=ADEME/LISTING_DATA

# ---------------------------------------------------------------------------
# collect_listings.py
# ---------------------------------------------------------------------------
GCS_CLUSTERS_PATH=These/Bastien/DIFFINDISC/geo-culsters.plk
LISTINGS_SAVE_PATH=data/listings.parquet
LISTINGS_MARKET_GEO_COL=iris_id
LISTINGS_ITEM_TYPE=APARTMENT
LISTINGS_DATE_TO=2023-12-01
LISTINGS_MONTH_COUNT=36
LISTINGS_NB_MONTH=3
LISTINGS_BY_CAT=0
# Geographic filter: column name and comma-separated list of IDs
LISTINGS_GEO_LABEL=iris_id
LISTINGS_GEO_IDS=
