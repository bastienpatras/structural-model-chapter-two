# =============================================================================
# ADEME Geocoding Configuration
# =============================================================================
# Copy this file to .env and fill in your actual credentials
# DO NOT commit .env to git!

# Aviv Geocoding API
AVIV_GEOCODING_API_KEY=your-api-key-here

# Rate Limiting (optional - uses defaults if not set)
GEOCODING_MAX_RPS=100
GEOCODING_CONCURRENT_LIMIT=50
GEOCODING_MAX_RETRIES=3
GEOCODING_TIMEOUT=10

# Database Configuration (optional - only needed for legacy geo lookup)
DB_USER=your-db-username
DB_PASSWORD=your-db-password
DB_NAME=meilleursagents_prod
DB_HOST=localhost
DB_PORT=3333

# GCS Configuration
GCS_BUCKET=ma-data-dev
